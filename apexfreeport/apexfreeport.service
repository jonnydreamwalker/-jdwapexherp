[Unit]
Description=Apex FreePort inventory bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/apexfreeport
EnvironmentFile=-/etc/apexfreeport.env
ExecStart=/usr/bin/node /home/ec2-user/apexfreeport/server.js
Restart=always
RestartSec=3
StandardOutput=append:/home/ec2-user/apexfreeport/server.log
StandardError=append:/home/ec2-user/apexfreeport/server.log

# Hardening (safe defaults)
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
